<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Brightloop Module Category -->
        <record id="module_category_brightloop" model="ir.module.category">
            <field name="name">Brightloop Subscription Management</field>
            <field name="description">User access level for Brightloop Subscription Management System</field>
            <field name="sequence">25</field>
        </record>

        <!-- Brightloop Groups Privilege (Odoo 19) -->
        <record id="res_groups_privilege_brightloop" model="res.groups.privilege">
            <field name="name">Subscriptions</field>
            <field name="category_id" ref="brightloop_base.module_category_brightloop"/>
            <field name="sequence">25</field>
        </record>

        <!-- Customer Group (Portal User) -->
        <record id="group_brightloop_portal" model="res.groups">
            <field name="name">Customer</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">Customer role: Self-service access to own subscriptions and invoices via customer portal.</field>
        </record>

        <!-- Internal Staff Group -->
        <record id="group_brightloop_user" model="res.groups">
            <field name="name">Internal Staff</field>
            <field name="privilege_id" ref="brightloop_base.res_groups_privilege_brightloop"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Internal staff role: Operational access to manage subscriptions, quotations, and permitted day-to-day activities.</field>
        </record>

        <!-- Administrator Group -->
        <record id="group_brightloop_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="brightloop_base.res_groups_privilege_brightloop"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('brightloop_base.group_brightloop_user')), (4, ref('base.group_system'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Administrator role: Full control over products, plans, discounts, staff creation, billing, and system configuration.</field>
        </record>
    </data>
</odoo>
