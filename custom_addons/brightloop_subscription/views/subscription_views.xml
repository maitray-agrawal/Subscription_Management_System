<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription List View -->
    <record id="brightloop_subscription_view_list" model="ir.ui.view">
        <field name="name">brightloop.subscription.list</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-info="state == 'draft'" decoration-warning="state == 'quotation'" decoration-success="state == 'active'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="next_billing_date"/>
                <field name="total_quantity"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="is_paused" widget="boolean_toggle" readonly="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'quotation'" decoration-primary="state == 'confirmed'" decoration-success="state == 'active'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="brightloop_subscription_view_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.form</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_to_quotation" string="Create Quotation" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'quotation'"/>
                    <button name="action_activate" string="Activate Subscription" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_pause" string="Pause" type="object" class="btn-secondary" invisible="state != 'active' or is_paused"/>
                    <button name="action_resume" string="Resume" type="object" class="btn-primary" invisible="state != 'active' or not is_paused"/>
                    <button name="action_renew" string="Renew" type="object" class="btn-secondary" invisible="state not in ('active', 'closed')"/>
                    <button name="action_close" string="Close Subscription" type="object" class="btn-secondary" invisible="state not in ('confirmed', 'active')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Paused" bg_color="text-bg-warning" invisible="not is_paused"/>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-danger" invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <label for="name" string="Subscription Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="partner_and_plan">
                            <field name="partner_id" readonly="state in ('active', 'closed')"/>
                            <field name="plan_id" readonly="state in ('active', 'closed')"/>
                            <field name="template_id" invisible="state != 'draft'" readonly="state != 'draft'"/>
                            <field name="payment_term_id" readonly="state == 'closed'"/>
                        </group>
                        <group name="dates_and_status">
                            <field name="start_date" readonly="state == 'closed'"/>
                            <field name="expiry_date" readonly="state == 'closed'"/>
                            <field name="validity_date" invisible="state not in ('draft', 'quotation')"/>
                            <field name="next_billing_date" invisible="state != 'active'" readonly="1"/>
                            <field name="is_paused" invisible="1"/>
                            <field name="pause_date" invisible="not is_paused"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Subscription Lines">
                            <field name="line_ids" readonly="state in ('active', 'closed')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                        <page name="financials" string="Contract &amp; Financial Metrics">
                            <group>
                                <group name="recurring_metrics" string="Metrics">
                                    <field name="mrr" widget="monetary"/>
                                    <field name="total_quantity"/>
                                    <field name="is_eligible_for_billing"/>
                                    <field name="last_billing_date"/>
                                </group>
                                <group name="contract_meta" string="Contract Details">
                                    <field name="origin_subscription_id" invisible="not origin_subscription_id"/>
                                    <field name="close_reason" invisible="not close_reason"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Subscription Kanban View -->
    <record id="brightloop_subscription_view_kanban" model="ir.ui.view">
        <field name="name">brightloop.subscription.kanban</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="is_paused"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-2">
                            <strong><field name="name"/></strong>
                            <span t-if="record.is_paused.raw_value" class="badge text-bg-warning">Paused</span>
                        </div>
                        <div class="text-muted mb-1">
                            <field name="partner_id"/>
                        </div>
                        <div class="text-muted mb-2">
                            <field name="plan_id"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><field name="amount_total" widget="monetary"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Subscription Search View -->
    <record id="brightloop_subscription_view_search" model="ir.ui.view">
        <field name="name">brightloop.subscription.search</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name" string="Subscription or Customer" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Quotations" name="filter_quotation" domain="[('state', '=', 'quotation')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Paused" name="filter_paused" domain="[('is_paused', '=', True)]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Due for Invoicing" name="filter_due_billing" domain="[('is_eligible_for_billing', '=', True)]"/>
                <group>
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Plan" name="group_by_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_brightloop_quotation" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('state', 'in', ['draft', 'quotation'])]</field>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="search_view_id" ref="brightloop_subscription_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Subscription Quotation!
            </p>
        </field>
    </record>

    <record id="action_brightloop_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['confirmed', 'active', 'closed'])]</field>
        <field name="search_view_id" ref="brightloop_subscription_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active or confirmed subscriptions found. Confirm a quotation to start a contract!
            </p>
        </field>
    </record>
</odoo>
